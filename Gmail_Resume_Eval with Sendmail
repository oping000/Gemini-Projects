/**
 * Extracts text dynamically based on whether it is a PDF or a Word Document
 */
function extractTextFromAttachment(attachment) {
  try {
    const fileBlob = attachment.copyBlob();
    const mimeType = attachment.getContentType();
    
    const resource = {
      title: fileBlob.getName(),
      mimeType: mimeType,
      parents: [{ id: EVAL_FOLDER_ID }] 
    };
    
    let docFile;
    
    if (mimeType === "application/pdf") {
      docFile = Drive.Files.insert(resource, fileBlob, { ocr: true });
    } else {
      docFile = Drive.Files.insert({
        title: fileBlob.getName(),
        parents: [{ id: EVAL_FOLDER_ID }]
      }, fileBlob, { convert: true });
    }
    
    const doc = DocumentApp.openById(docFile.id);
    const text = doc.getBody().getText();
    
    Drive.Files.remove(docFile.id); 
    
    return text;
  } catch (e) {
    Logger.log("Error extracting text: " + e.toString());
    return null;
  }
}

/**
 * Saves the approved Executive Summary permanently to Drive
 */
function saveSummaryToDrive(candidateName, summaryText) {
  try {
    const folder = DriveApp.getFolderById(PERMANENT_SUCCESS_FOLDER_ID);
    const fileName = `${candidateName} - Executive Summary.txt`;
    folder.createFile(fileName, summaryText, MimeType.PLAIN_TEXT);
  } catch (e) {
    Logger.log("Error saving permanent file: " + e.toString());
  }
}

/**
 * Requests a JSON validation format from Gemini text output based on ORIGINAL document length
 */
function evaluateResumeStructured(resumeText) {
  const prompt = `
    You are a data validation system. Process the raw resume data below into an Executive Summary, then execute your 3 QA checks.
    You must output your response strictly as a valid, single parseable JSON object matching the schema requested below. Do not include any introductory or concluding text.

    [Raw Resume Data]
    ${resumeText}

    ---
    GUARDRAIL RULES:
    1. **Key Technical Skills**: Ensure the summary explicitly calls out core technical tools found in the raw data (like Snowflake, SQL, Python, Tableau, Power BI, etc.). Set "technicalSkillsCheck" to "Pass" or "Fail".
    2. **Strict Original Length Limit**: Count the total words in the provided [Raw Resume Data] text. If the original document text is strictly 1000 words or fewer, set "lengthCheck" to "Pass". If it is over 1000 words, set "lengthCheck" to "Fail".
    3. **Data Integrity**: Cross-reference everything. No hallucinations. Set "dataIntegrityCheck" to "Pass" or "Fail".
    4. **Pass All Flag**: If ALL THREE of the above checks are "Pass", set "passAllChecks" to true. If ANY fail, set "passAllChecks" to false.

    ---
    JSON SCHEMA OUTPUT FORMAT:
    {
      "executiveSummary": "Your generated summary string here...",
      "technicalSkillsCheck": "Pass",
      "lengthCheck": "Pass",
      "dataIntegrityCheck": "Pass",
      "passAllChecks": true
    }
  `;

  const payload = {
    contents: [{ parts: [{ text: prompt }] }]
  };

  const options = {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };

  try {
    const response = UrlFetchApp.fetch(`${EVAL_GEMINI_URL}?key=${EVAL_GEMINI_KEY}`, options);
    const responseText = response.getContentText();
    const json = JSON.parse(responseText);
    
    if (json.error) {
      Logger.log("Gemini API Error: " + json.error.message);
      return null;
    }
    
    if (json.candidates && json.candidates[0].content.parts[0].text) {
      let rawText = json.candidates[0].content.parts[0].text;
      rawText = rawText.replace(/```json/gi, "").replace(/```/g, "").trim();
      const parsedEval = JSON.parse(rawText);
      return parsedEval;
    }
    
    return null;
  } catch (e) {
    Logger.log("Error parsing text to JSON object: " + e.toString());
    return null;
  }
}
